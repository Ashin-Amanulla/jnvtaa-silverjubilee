# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/jnvta-silver-jubilee

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@jnvta.org

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# AWS S3 Configuration for Gallery
# Bucket: school-jnv
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=school-jnv

# S3 Folder Configuration (optional - leave empty to list all images from bucket root)
# Add your S3 folder prefixes (comma-separated)
S3_FOLDER_PREFIXES=opening-ceremony,cultural-events,closing-ceremony

# Folder display names (comma-separated, must match order of prefixes)
S3_FOLDER_NAMES=Opening Ceremony,Cultural Events,Closing Ceremony

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
